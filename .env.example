# FinalSay environment configuration (example).
#
# Copy to `.env` in the directory you run the backend from (typically
# `backend/`) and adjust as needed. Every variable uses the FINALSAY_ prefix.
# The values below are the safe, fully-offline demo defaults: SQLite + MOCK
# comparison model + LOCAL anchor, with NO paid API keys required.

# --- Database -----------------------------------------------------------------
# SQLite (default, no external service needed):
FINALSAY_DATABASE_URL=sqlite:///./finalsay.db
# PostgreSQL (opt-in; e.g. via `scripts/run_demo.sh --postgres`):
# FINALSAY_DATABASE_URL=postgresql+psycopg2://finalsay:finalsay@127.0.0.1:5432/finalsay

# --- Comparison model ---------------------------------------------------------
# mock  = deterministic, offline rule engine (default)
# hf    = HuggingFace zero-shot NLI (opt-in; downloads a model, no API key)
FINALSAY_COMPARISON_MODEL=mock
FINALSAY_HF_MODEL_NAME=facebook/bart-large-mnli

# --- Provenance anchor --------------------------------------------------------
# local   = append-only local hash chain (default, always available)
# polygon = anchor daily Merkle roots to Polygon Amoy testnet (opt-in)
FINALSAY_ANCHOR=local
# Only used when FINALSAY_ANCHOR=polygon:
# FINALSAY_POLYGON_RPC_URL=
# FINALSAY_POLYGON_PRIVATE_KEY=
# FINALSAY_POLYGON_CONTRACT=

# --- Classification gating ----------------------------------------------------
# Predictions below this confidence become `unresolved` and go to the reviewer
# queue.
FINALSAY_CONFIDENCE_THRESHOLD=0.6

# --- Auth ---------------------------------------------------------------------
# HS256 signing secret. Override for anything beyond a local demo.
FINALSAY_JWT_SECRET=dev-insecure-finalsay-secret-change-me

# --- OCR ----------------------------------------------------------------------
# Path to the tesseract binary. "auto" autodetects it on PATH. If no engine is
# present, image OCR degrades to HTTP 422 (paste text instead); PDF/paste work.
FINALSAY_TESSERACT_CMD=auto
